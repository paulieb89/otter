# Copy to .env (gitignored) — the CLI auto-loads it from the directory you
# launch in. Shell-exported variables take precedence over this file.

# Required unless you use a gateway that needs no key.
ANTHROPIC_API_KEY=

# Optional: model id (this is the default).
# OTTER_MODEL=claude-sonnet-4-6

# Optional: point at a gateway/proxy instead of api.anthropic.com.
# ANTHROPIC_BASE_URL=
